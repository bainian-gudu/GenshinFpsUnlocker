# Build outputs (cmake / intermediate)
build/
out/
dist/
bin/
obj/
target/
artifacts/
node_modules/
.vs/
*.user
*.suo
*.sdf
*.opensdf
cmake-build-*/

# Local config / logs
config.json
*.log

# Compiled binaries in tree (CI produces under dist/ ; installer/tools/)
*.dll
*.exe
*.pdb
!third_party/**


# OS / editor
.arena/
.cache/
.local/
.DS_Store
Thumbs.db
*~

# Extra docs (do not track) — installer/ 下的说明文档例外
docs/
*.md
!README.md
!installer/README.md
!installer/kachina/README.md
!installer/kachina/UPSTREAM.md
!installer/kachina/LOCAL_PATCHES.md
!installer/kachina/vendor/rcedit-rs/LOCAL_PATCHES.md

# ---------------------------------------------------------------------------
# 安装器打包（installer/）
#   kachina/         上游 kachina-installer 源码快照 —— 需要进版本库
#   tools/           由 installer/build-kachina.ps1 构建出的 kachina-builder.exe
#   其余为构建中间产物
# ---------------------------------------------------------------------------
installer/tools/
installer/kachina/node_modules/
installer/kachina/dist/
installer/kachina/.cache/
installer/kachina/src-tauri/target/
installer/kachina/src-tauri/gen/
installer/kachina/tests/fixtures/
# keep: installer/kachina.config.json, installer/pack.ps1, installer/build-kachina.ps1

# Web UI
src/Ui/node_modules/
src/Ui/dist/
src/Ui/*.tsbuildinfo

assets-gen/

# ---------------------------------------------------------------------------
# devcheck（tools/devcheck/）—— 本地快速体检，见 tools/devcheck/README.md
#   检查用的源码是生成物，不入库；说明文档要入库（上面 *.md 被忽略）
# ---------------------------------------------------------------------------
tools/devcheck/rust/*/src/gen/
tools/devcheck/front/gen/
tools/devcheck/front/.prettierrc
tools/devcheck/_selftest/
tools/devcheck/front/_selftest/
# -SelfTest 的仓库内改动锁与备份（进程被杀后靠它们恢复并清场）
tools/devcheck/.repo-lock
tools/devcheck/.selftest-backup/
!tools/devcheck/README.md
