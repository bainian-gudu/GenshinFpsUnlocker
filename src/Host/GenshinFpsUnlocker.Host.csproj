<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GenshinFpsUnlocker</AssemblyName>
    <RootNamespace>GenshinFpsUnlocker.Host</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.3.1</Version>
    <Authors>GenshinFpsUnlocker</Authors>
    <Description>原神帧率解锁 — 自定义 FPS、后台监视注入、托盘设置</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon></ApplicationIcon>
    <Product>GenshinFpsUnlocker</Product>
    <AssemblyTitle>原神帧率解锁</AssemblyTitle>
  </PropertyGroup>
</Project>
