<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Windows 10 1809+/Windows 11 平台标注；实际运行检测见 OsCompatibility（1607+） -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GenshinFpsUnlocker.Setup</AssemblyName>
    <RootNamespace>GenshinFpsUnlocker.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>原神帧率解锁 安装程序</Product>
    <AssemblyTitle>原神帧率解锁 安装程序</AssemblyTitle>
    <Description>原神帧率解锁图形安装器</Description>
    <Authors>GenshinFpsUnlocker</Authors>
  </PropertyGroup>
</Project>
